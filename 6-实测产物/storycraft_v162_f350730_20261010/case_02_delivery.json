  "outline": {
    "title": "寻星指南",
    "premise": "高三学生林夏和好友陈宇在闭馆后的图书馆蹲守一本每晚自动归位的《寻星指南》，试图抓住“幽灵”，却意外发现了好友为她制造的温暖奇迹。",
    "theme": "真正的奇迹不是超自然现象，而是朋友为了守护你的信念而付出的笨拙努力。",
    "beginning": "林夏和陈宇在闭馆后的图书馆发现《寻星指南》再次自动归位，林夏决定设下陷阱抓住这个“幽灵”，以证明自己对生活仍有掌控力。",
    "development": "陷阱失败后，林夏借机发泄考试失利的焦虑。陈宇引导她发现书中每次归位都会多出的折角和左手铅笔留言，线索逐渐指向陈宇自己。",
    "climax": "林夏通过陈宇手腕的膏药识破真相，陈宇坦白自己每天偷偷藏书又放回，只为兑现林夏“看到奇迹就能考好”的玩笑话。林夏面临逃避与面对的选择。",
    "ending": "林夏选择接受奇迹并面对现实，写下回复后将书轻轻推回书架。两人在温暖的余韵中离开，书本静静立在原处。",
    "episode_outlines": [
      {
        "index": 1,
        "title": "第三排书架的奇迹",
        "core_goal": "揭开《寻星指南》自动归位的真相，完成林夏从焦虑自我怀疑到被友情治愈、主动选择面对现实的心理转变。",
        "major_beats": [
          "【0-3s】沉重的《寻星指南》砸在桌面上（突发音效），林夏急促喘息：“它又自己回来了！”",
          "【3-10s】陈宇打开手电筒（咔哒声），光束扫过第三排书架。林夏咬牙发誓今晚必须抓住这个“幽灵”，证明自己的生活还没完全失控。",
          "【10-30s】林夏在书页涂抹荧光粉并躲入暗处。书架后传来摩擦声，林夏猛地拉开挡板（音效断点），却发现只是流浪猫碰落了书，荧光粉沾了一手，紧张感瞬间泄气。",
          "【30-120s】两人继续蹲守，林夏借机发泄模拟考失利的焦虑，觉得连书都在嘲弄她。陈宇引导她检查书本，林夏发现每次归位第42页都有折角，且多了一句左手铅笔写的“星星不怕黑夜”。陈宇提醒她注意纸面上深深的左手握笔压痕和淡淡的薄荷膏药味。",
          "【120-170s】林夏闻到陈宇身上的薄荷味，注意到他左手腕的膏药，猛然醒悟。陈宇坦白自己每天偷偷藏书又放回，只为兑现她“看到奇迹就能考好”的玩笑话。林夏面临选择：是继续用“抓幽灵”逃避考试压力，还是接受这份人为的奇迹。",
          "【170-180s】林夏选择面对现实，拿笔写下“奇迹已收到，接下来换我自己走”。她将书轻轻推入书架（书脊摩擦声呼应开场的砸桌声），两人并肩离开，微风吹动书页，温暖收束。"
        ],
        "ending": "Closed",
        "target_duration_sec": 180
      }
    ],
    "character_portrayals": [
      {
        "role_id": "role-1",
