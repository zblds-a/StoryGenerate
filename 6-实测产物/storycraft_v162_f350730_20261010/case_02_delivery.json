    "performance_plan": {
      "sound_design": "突出图书馆闭馆后的空旷感。开场沉重的砸书声与结尾轻柔的推书声形成听觉与心理的对比呼应；使用手电筒开关声、流浪猫碰倒物品的声音、以及最后微风吹动书页的沙沙声来构建空间与情绪。",
      "voice_direction": "林夏的情绪从紧绷、焦躁逐渐过渡到释怀和坚定；陈宇始终保持沉稳，但在坦白时带有一丝不好意思的温柔。"
    },
    "continuity_constraints": [
      "《寻星指南》必须始终在第三排书架。",
      "陈宇的左手腕膏药必须在前期有微小的音效或台词铺垫（如淡淡的薄荷膏药味）。",
      "铅笔留言必须是左手书写，以匹配陈宇的左撇子设定。",
      "开场沉重的砸书声必须在结尾有轻柔的推书声作为听觉呼应。"
    ],
    "change_summary": [
      "林夏从相信“超自然奇迹”转变为相信“人为的温暖奇迹”。",
      "林夏对模拟考失利的焦虑被陈宇的友情治愈，选择主动面对现实考试。"
    ]
  },
