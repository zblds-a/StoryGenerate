  "outline": {
    "title": "小王子归位之谜",
    "premise": "校图书馆每晚有一本《小王子》自动归位，即将转学的夏桐与好友陆明深夜蹲守，却意外揭开了严厉管理员隐藏在机关背后的温柔秘密。",
    "theme": "严厉外表下的温柔与青春期的告别",
    "beginning": "夏桐和陆明在闭馆后的图书馆监控死角蹲守，等待《小王子》自动归位的灵异现象。",
    "development": "两人发现书本是通过鱼线和通风口滑轮被拉走的，决定追踪机关源头。",
    "climax": "在旧设备间抓到“作案者”，发现是平时最严厉的图书管理员王老师，他正为借书的学生手绘插图。",
    "ending": "夏桐放弃拍摄灵异视频，选择记录温暖，王老师将书借给夏桐作为告别礼物，首尾声音呼应，温暖收束。",
    "episode_outlines": [
      {
        "index": 1,
        "title": "飞翔的小王子",
        "core_goal": "解开《小王子》自动归位的谜团，完成夏桐转学前的心愿。",
        "major_beats": [
          "【0-3s】突发听觉事件：深夜图书馆，清脆的“啪”声伴随书页快速翻动的沙沙声，夏桐压低声音惊呼“它又自己动了”。",
          "【3-10s】陆明拉着夏桐蹲在书架后，指出闭馆且处于监控死角；夏桐举着手机，表明必须拍下《小王子》自动归位的视频，作为转学前最酷的告别。",
          "【10-30s】等待无果，陆明劝她放弃。突然书架传来摩擦声，夏桐猛地打开手电筒和手机录像，光束下《小王子》正从半空“飞”回书架，陆明倒吸凉气，夏桐激动地喊“拍到了”。",
          "【30-120s】陆明检查书架发现极细的透明鱼线，夏桐顺线找到通风口；陆明推断是物理机关。两人顺着鱼线溜到旧设备间，听到里面的咳嗽声与画笔摩擦纸张的声音。夏桐手机还在录像，准备拍下“幕后黑手”。",
          "【120-155s】夏桐推开门，手机镜头对准桌面，发现是平时最严厉的王老师。桌上放着《小王子》和一叠手绘插图。王老师局促地挡住镜头，承认自己太凶吓跑学生，想用鱼线机关和手绘插图给借书同学惊喜。",
          "【155-170s】夏桐面临选择：手机还在录像，王老师尴尬地请求她删掉，怕被当成怪人。夏桐看着王老师粗糙的手和精美的插图，深吸一口气，清晰地按下手机“停止录像”的“滴”声，说“不拍灵异了，拍这个”。",
          "【170-180s】夏桐帮王老师把书挂回鱼线，两人一起拉动。开场那声清脆的“啪”声和翻书声再次响起，伴随着夏桐和陆明的轻笑。王老师将书递给夏桐作为告别礼物，温暖收束。"
        ],
        "ending": "夏桐选择分享温暖而非猎奇，亲手重现机关声音呼应开场，王老师赠书作为告别，情感余韵收束。",
        "target_duration_sec": 180
      }
    ],
    "character_portrayals": [
      {
        "role_id": "role-1",
        "story_name": "夏桐",
        "external_goal": "拍下图书馆“幽灵归位”的视频证据，作为转学前的完美告别。",
        "emotional_avoidance": "用寻找刺激和打破规则来掩饰对离开朋友和熟悉环境的不舍与焦虑。",
        "speech_style": "语速快，喜欢用反问和夸张词汇（如“你信不信”“绝对有鬼”），紧张或掩饰情绪时会不自觉地深呼吸并加快语速。",
        "relationship_stance": "依赖陆明的理性兜底，但表面嫌弃他死板，试图用冒险拉他一起打破规则。"
      },
      {
        "role_id": "role-2",
        "story_name": "陆明",
        "external_goal": "确保夏桐不因违规滞留图书馆而被处分，安全送她回家。",
        "emotional_avoidance": "用“校规”和“逻辑分析”来压抑自己对夏桐即将离开的失落，不敢直接表达关心。",
        "speech_style": "句式简短，偏好陈述句和逻辑连接词（如“首先”“根据监控”），被打断或无奈时会停顿并叹气。",
        "relationship_stance": "嘴上用校规反对，行动上却总是挡在夏桐前面保护她，用逻辑掩饰不舍。"
      }
    ],
