  "outline": {
    "title": "铁疙瘩的才艺秀",
    "premise": "社团新成员误将报废机器人报名才艺比赛，在无法退赛的情况下硬着头皮让其登台，却意外播放了社团温馨日常，引发善意误会与感动。",
    "theme": "青春、包容、意外的温暖",
    "beginning": "新成员角色1在整理社团物资时，误操作将展示用机器人报名了校园才艺大赛。",
    "development": "发现无法退赛后，角色1与社长试图给机器人临时编程简单的动作，却频频出错，只能硬着头皮推上舞台。",
    "climax": "舞台上机器人动作死机，却意外触发了隐藏音频，播放出社团成员互相鼓励的温馨录音，打动了全场。",
    "ending": "机器人以独特的“情感表演”获得认可，社团成员在欢笑与感动中收获了更深的羁绊。",
    "episode_outlines": [
      {
        "index": 1,
        "title": "铁疙瘩的才艺秀",
        "core_goal": "展现角色1误报机器人参赛的慌乱，以及最终意外收获感动的反转过程。",
        "major_beats": [
          "0-2s: 刺耳的系统提示音突然响起，播报机器人报名成功。",
          "2-7s: 角色1惊恐万分，交代自己误把社团报废机器人报上了即将海选的才艺比赛。",
          "7-20s: 社长赶来要求退赛，角色1疯狂操作发现系统锁死，伴随警报声只能决定硬上。",
          "20-80s: 两人疯狂给机器人写代码排练广播体操，台词短促，机器人频频卡顿冒烟。",
          "80-113s: 海选现场机器人死机，却意外播放出社长鼓励新成员的温柔录音和社团欢笑声，全场感动鼓掌。",
          "113-120s: 评委刚要点评，机器人头部突然弹出彩带炮炸了评委一脸，在惊呼声中戛然而止。"
        ],
        "ending": "评委被彩带炮袭击，悬念拉满，情绪在最高点的喜剧冲突中戛然而止。",
        "target_duration_sec": 120
      }
    ],
