  "outline": {
    "title": "第120秒的抉择",
    "premise": "裁员前夕，职场新人发现项目致命错误，在明哲保身与坚守底线之间做出抉择，却意外收获了前辈的并肩作战。",
    "theme": "职场中的诚实、勇气与代际传承的温暖。",
    "beginning": "裁员名单打印的刺耳声中，新人发现项目数据错误，面临是否公开的挣扎。",
    "development": "新人顶住压力发送揭露邮件，引发办公室震荡，被主管叫去谈话，气氛紧张。",
    "climax": "主管并未责罚，反而坦白自己早已知情却懦弱退缩，新人的勇气唤醒了主管的初心，两人决定共同面对高层。",
    "ending": "高层介入准备开除两人，主管却拿出创业计划书，带着新人昂首离开，留下温暖的余韵与悬念。",
    "episode_outlines": [
      {
        "index": 1,
        "title": "第120秒的抉择",
        "core_goal": "展现新人在裁员危机中坚守底线的勇气，并引出前辈并肩作战的温暖反转。",
        "major_beats": [
          "S1(0-2s): 黄金钩子。裁员名单打印机突然发出刺耳的卡纸警报声，打破办公室死寂。",
          "S2(2-7s): 矛盾三要素。新人（角色1）盯着屏幕上的项目致命错误数据，手指悬在‘全员发送’键上，内心挣扎是否要在被裁前当这个吹哨人。",
          "S3(7-20s): 第一次反转/爽点。前辈路过低声警告‘别犯傻’，新人深吸一口气，伴随清脆的键盘敲击声和邮件发送成功的提示音，果断公开错误。",
          "S4(20-80s): 中段推进。办公室瞬间死寂后爆发窃窃私语。主管将新人叫进办公室，台词短促交锋。主管质问动机，新人坚持‘不能让客户承担后果’，气氛压抑到极点。",
          "S5(80-113s): 升级/二次反转。主管突然卸下伪装，叹气承认自己早知错误但迫于高层压力隐瞒。主管被新人的纯粹打动，撕毁手中的裁员同意书，决定带新人一起向高层摊牌。",
          "S6(113-120s): 强钩子。办公室门被高层猛然推开，冷冷宣布两人被解雇。主管却笑着递给新人一份新公司的合伙协议：‘走，我们自己干。’声音戛然而止。"
        ],
        "ending": "主管与新人共同面对被解雇的结局，但主管抛出创业邀请，将职场危机转化为温暖的新起点，情绪在最高昂处收尾。",
        "target_duration_sec": 120
      }
    ],
