  "outline": {
    "title": "归位的《小王子》",
    "premise": "高三学生林晓和好友陈宇在闭馆后的图书馆调查一本书自动归位的“灵异”事件，最终发现这是已故爷爷留下的温暖守护，并勇敢做出告别与前行的选择。",
    "theme": "爱与记忆的延续，面对压力与失去的勇气，以及朋友间默默的守护。",
    "beginning": "闭馆后的图书馆，林晓和陈宇目睹《小王子》自动归位，决定查明真相。",
    "development": "两人发现机关和定时器，线索指向林晓已故的爷爷，揭开爷爷生前拜托老馆长设置的秘密。",
    "climax": "录音笔播放出爷爷的遗言，揭示书本归位是为了提醒林晓早点回家，林晓面临是否关闭机关的内心抉择。",
    "ending": "林晓选择按下停止键并亲手将书归位，呼应开场；老馆长通过广播送上关怀，陈宇发现爷爷留给自己的隐藏留言，故事在温暖的情感高潮中结束。",
    "episode_outlines": [
      {
        "index": 1,
        "title": "归位的《小王子》",
        "core_goal": "查明书本自动归位的真相，完成情感治愈与人物成长选择。",
        "major_beats": [
          "【0-3s 黄金钩子】寂静的图书馆内，突发清晰的“咔哒”一声脆响，紧接着是书本滑入书架的沉闷摩擦声，打破平静。",
          "【3-10s 矛盾三要素】林晓颤抖着指出《小王子》又自己回去了，陈宇打开手电筒照亮C区，表示今晚非要查出是谁在装神弄鬼，确立调查目标。",
          "【10-30s 第一次反转】陈宇猛地拉开书架旁的杂物柜，里面没人，却掉出一个运转的蓝牙音箱和定时器。林晓刚松口气，陈宇捡起定时器，发现上面刻着林晓已故爷爷的名字，伴随音效重音断点，悬疑转向情感。",
          "【30-120s 中段推进】陈宇检查定时器发现它连着微型滑轨，两人顺着电线找到旧工作台和日记。陈宇念出日记揭示爷爷拜托老馆长装机关陪伴林晓，林晓哭诉爷爷不懂机械，加深情感矛盾与事实拼图。",
          "【120-170s 升级/二次反转】工作台暗格弹开掉出录音笔，陈宇按下播放，爷爷录音指示“若不再需要躲避，就亲手把书放回并按下停止键”。林晓面临保留机关自欺欺人或接受现实的选择，最终深吸一口气按下停止键，完成人物成长。",
          "【170-180s 强钩子】林晓拿起《小王子》亲手推入书架，清脆的“咔哒”声呼应开场。老馆长广播响起，陈宇翻看定时器背面念出隐藏留言“致陈宇，谢谢你替我保护她”，情感反转将情绪推向最高潮后戛然而止。"
        ],
        "ending": "林晓解开心结并做出勇敢的选择，感受到爷爷跨越生死的爱与朋友的守护，在老馆长的温暖广播中结束。",
        "target_duration_sec": 180
      }
    ],
