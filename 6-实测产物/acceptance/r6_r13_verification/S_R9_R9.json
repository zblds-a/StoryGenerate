  "outline": {
    "title": "蝴蝶牌缝纫机",
    "premise": "九十年代下岗潮中，女工林素珍拒绝接受抵工资的旧棉被，借走厂里的老缝纫机，用碎布头在夜市拼出一条生路，最终在时代洪流中完成手艺与精神的传承。",
    "theme": "时代洪流中小人物的坚韧抗争与手艺传承。",
    "beginning": "林素珍在厂办接到下岗通知，面临女儿借读费和工厂用旧棉被抵薪的双重困境。",
    "development": "林素珍借走缝纫机，熬夜用废料改制童装，在夜市摆摊遭遇驱赶，却意外被南方批发商看中设计并下达大单。",
    "climax": "面对大单带来的机器与布料短缺，林素珍重返工厂，决定买下所有废料并正式承包车间机器，向命运发起反击。",
    "ending": "缝纫机的轰鸣声跨越时空，与现代高定秀场的掌声交织，成年后的女儿道出母亲的手艺与精神已得到传承。",
    "episode_outlines": [
      {
        "index": 1,
        "title": "哒哒作响的时代",
        "core_goal": "林素珍在下岗绝境中通过缝纫手艺找到生存出路，并接下改变命运的第一笔大单。",
        "major_beats": [
          "【0-3s】铁桌被重重拍响，伴随收音机‘国企改革’的电流声，王主任将解除劳动合同书推到林素珍面前。",
          "【3-10s】王主任表示厂里没钱，只能用库存旧棉被抵工资。林素珍攥着通知书，焦急表示女儿明天必须交借读费。",
          "【10-30s】王主任劝她认命，林素珍爆发推开棉被，要求借走厂里淘汰的蝴蝶牌缝纫机三个月。伴随音乐断点，转场至深夜急促的缝纫机踏板声。",
          "【30-120s】林素珍熬夜将旧棉被和碎布头裁剪拼接成流行童装，让小雅试穿。次日夜市，素珍摆摊遭遇管理员驱赶，衣服散落泥地。",
          "【120-170s】素珍蹲地捡衣服时，南方批发商看中拼接设计，拍下定金要求明早交50件。素珍面临绝境，决定回厂找王主任买下所有废料并长租机器。",
          "【170-180s】素珍推开车间大门推上电闸，缝纫机马达轰鸣达到情绪顶点。机器声平滑渐变为现代秀场快门声，成年小雅画外音点出传承，平稳收束。"
        ],
        "ending": "情感回响式收束。缝纫机声跨越时代，落在现代高定工作室的传承上，不留悬念，余韵悠长。",
        "target_duration_sec": 180
      }
    ],
