  "outline": {
    "title": "南方的回音",
    "premise": "退休刑警在整理旧物时，通过一盘二十年前的磁带录音，发现被定性为“畏罪潜逃”的搭档其实是为了救自己的女儿而牺牲，并默默背负了黑锅。",
    "theme": "真相的重量与守护的温情",
    "beginning": "老林和小赵在整理旧案卷宗时，意外播放了一盘属于“黑警”老陈的磁带，录音中老陈承认拿钱放人，小赵认为铁证如山。",
    "development": "老林通过录音背景音的破绽和一张当票，推翻了老陈潜逃的假象，发现老陈当年去了废弃的旧火车站，且当掉了老林遗失的警号。",
    "climax": "老林拼凑出真相：当年被绑架的人质是老林的女儿，老陈为换人质同归于尽。录音最后老陈嘱托老林不要告诉女儿真相，就说他去了南方。",
    "ending": "面对是否翻案的选择，老林决定保全老陈的牺牲与女儿的平静，用一句“老陈在南方”为二十年的悬案画上温暖的句号。",
    "episode_outlines": [
      {
        "index": 1,
        "title": "南方的回音",
        "core_goal": "揭开搭档失踪的真相，完成情感与认知的双重反转。",
        "major_beats": [
          "[0-3s] 突发听觉事件：老式磁带机“咔哒”按下，紧接着是一声沉闷的枪响和重物砸在铁轨上的声音。",
          "[3-10s] 矛盾三要素：小赵惊呼这盘带子为何在“黑警”陈叔的遗物箱底，老林命令小赵把音量调大，继续播放。",
          "[10-30s] 第一次反转：录音中老陈喘息着说“钱我拿了，人我放了”，小赵叹息铁证如山，老林暴怒拍桌，指出老陈戒烟多年根本不可能有钱买偷渡船票，反驳潜逃定论。",
          "[30-120s] 中段推进：老林让小赵戴上耳机细听背景音，小赵误以为是码头海浪声，老林指出那是旧火车站排风扇的低频轰鸣；小赵翻出磁带盒底部的半张当票，念出当物是“警号0842”，老林震惊，那是他当年在追捕中遗失的警号。",
          "[120-150s] 二次反转与真相揭示：老林颤抖着拼凑出真相：当年被绑架的人质是老林的女儿，老陈为了换出女孩，穿上嫌犯外套引开歹徒，在火车站同归于尽；录音最后老陈留下遗言：“林哥，丫头明天高考，别告诉她我死了，就说我去了南方。”",
          "[150-180s] 人物选择与余韵：小赵哽咽问是否要上报翻案，老林拿出老陈留下的旧打火机“咔哒”点燃，平静地说“案子结了，老陈在南方，活得挺好”，磁带机自动弹起“咔哒”收尾。"
        ],
        "ending": "老林选择隐瞒翻案，用打火机点燃香烟，以一句温暖的谎言告慰亡友，磁带机弹起的声音留下悠长余韵。",
        "target_duration_sec": 180
      }
    ],
