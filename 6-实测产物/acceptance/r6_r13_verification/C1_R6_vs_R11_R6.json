    "mystery_causal_proof": {
      "actual_event_timeline": "二十年前，老陈在旧火车站与歹徒搏斗同归于尽，牺牲前用随身录音机录下遗言，并将老林遗失的警号当掉作为信物，磁带由线人暗中寄给老林，被老林妻子误作杂物收起，直到今日老林退休整理旧物才修复播放。",
      "witnessed_event": "老林和小赵现在听到录音，发现背景音不是海浪而是火车站排风扇，且当票当物是老林的警号，从而推翻老陈潜逃的假象。",
      "actor_opportunity": "老陈在牺牲前几分钟，利用火车站废弃值班室的录音机录下遗言，并在追捕途中将老林掉落的警号当入沿途当铺，换取歹徒线索。",
      "audible_trace_before_reveal": "录音背景里的“海浪声”其实是排风扇的低频轰鸣，且老陈提到“钱我拿了”时声音带有火车站特有的空旷回音。",
      "onstage_verification": "小赵用手机调出旧火车站排风扇的音频资料进行比对，频率完全一致；当票上的编号对应老林当年挂失的警号0842。"
    },
    "performance_plan": {
      "sound_design": "磁带机的机械声（咔哒、沙沙声）作为时间转场的锚点；打火机点燃的清脆声作为情感落点；录音部分需做旧处理，加入底噪和空旷回音。",
      "voice_direction": "老林的台词从最初的威严暴怒，逐渐过渡到颤抖、压抑，最后归于极度平静的沧桑；小赵的情绪从疑惑到震惊再到哽咽；老陈的录音需表现出濒死的虚弱与对搭档的温情。"
    },
    "continuity_constraints": [
      "老陈的警号与老林的警号必须在台词中明确区分，当票上必须是老林的警号0842。",
      "录音带必须是物理介质（磁带），不能是数字文件，以符合二十年前的时代背景。",
      "老林的女儿在故事中不直接出场，仅通过台词提及，保持180秒的紧凑感。"
    ],
    "change_summary": [
      "初始状态：老林和小赵认为老陈是畏罪潜逃的黑警，老林试图寻找证据反驳但缺乏实质线索。",
      "最终状态：老林确认老陈是为救自己女儿而牺牲的英雄，选择隐瞒真相以保全老陈的“南方”谎言和女儿的平静生活。"
    ]
