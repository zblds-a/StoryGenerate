    "mystery_causal_proof": {
      "actual_event_timeline": "20年前11月4日雨夜，老陈在码头私吞黑钱并枪杀阿飞。",
      "witnessed_event": "老林当年因肺炎住院，听信老陈说阿飞黑吃黑潜逃，并在卷宗中只找到一段残缺录音。",
      "actor_opportunity": "老陈当年作为老林的搭档，代替生病的老林去码头接头，有充足时间杀人并伪造现场，事后将录音带剪接掩盖。",
      "audible_trace_before_reveal": "录音带中阿飞背景音有老陈独有的Zippo打火机开盖声，且老陈谎称老林住院时间（11月10日）与阿飞失踪时间（11月4日）不符。",
      "onstage_verification": "老林在现场重听录音确认打火机声，并核对卷宗上的日期戳，当面戳穿老陈的时间线谎言。"
    },
    "performance_plan": {
      "sound_design": "重点突出老式录音机的机械按键声、磁带转动声与电流底噪，以此作为连接过去与现在的听觉锚点。老陈的Zippo打火机声音需做特殊频段处理，使其在录音中和现实中具有高度辨识度。",
      "acting_notes": "老林的台词需体现出从愤怒、动摇到最终决绝的层次变化，呼吸声是重要的情绪辅助；老陈需保持表面的从容，仅在谎言被戳穿时通过吞咽和冷笑暴露内心的慌乱。"
    },
    "continuity_constraints": [
      "录音机与磁带作为核心道具必须贯穿全剧，不可中途消失或更换。",
      "老陈的Zippo打火机声音特征必须在第10-30秒的录音中首次出现，并在后续对话中保持人设一致。",
      "卷宗上的日期（11月4日与11月10日）必须与台词严格对应，不可出现逻辑漏洞。"
    ],
    "change_summary": [
