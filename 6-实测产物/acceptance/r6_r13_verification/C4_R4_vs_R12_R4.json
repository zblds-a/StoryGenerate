  "outline": {
    "title": "夹层里的配型单",
    "premise": "离婚冷静期最后一天，妻子在收拾行李时发现了丈夫隐藏的器官捐献卡，揭开了他伪装冷漠逼离婚的残酷真相。",
    "theme": "亲密关系中的自我牺牲与边界重塑；真正的爱不是替对方做决定，而是共同面对。",
    "beginning": "林夏收拾行李准备离婚，对周明宇的冷漠感到绝望，决心让他为“出轨”付出代价。",
    "development": "林夏意外发现器官捐献卡，将之前收集的“出轨”证据与卡片联系起来，逼问周明宇。",
    "climax": "周明宇坦白自己配型成功，为了绕过伦理审查和妻子的心理负担，故意制造感情破裂假象逼她离婚。",
    "ending": "林夏拒绝了丈夫单方面的“伟大牺牲”，划掉离婚协议，要求以配偶身份共同面对，重新定义了两人的婚姻边界。",
    "episode_outlines": [
      {
        "index": 1,
        "title": "最后一件行李",
        "core_goal": "揭示丈夫逼离婚的真实目的，妻子做出拒绝单方面牺牲的选择。",
        "major_beats": [
          "[0-3s] 行李箱重重砸在木地板上，拉链刺耳地拉合。林夏冷冷宣告：“字我签了，明天民政局见。”",
          "[3-10s] 客厅传来游戏音效，周明宇敷衍“放桌上”。林夏在衣柜夹层翻找护照，摸到一个硬纸壳。",
          "[10-30s] 林夏以为是他转移财产的流水，愤怒撕开信封，掉出的却是“活体器官捐献志愿书”和“配型成功报告”，接收人是林夏。",
          "[30-120s] 周明宇冲进卧室抢夺卡片。林夏躲开，拿出他“深夜去医院、给陌生账户打钱”的记录，原本以为是出轨铁证，此刻全对上了术前检查和手术押金。",
          "[120-150s] 周明宇崩溃大吼：“你说过不要家人的肾！我不跟你离婚，伦理委员会怎么批！我不装作嫌弃你，你怎么肯接受陌生人的肾！”",
          "[150-180s] 林夏拿笔在协议上重重划掉“离婚”二字，拍在他胸口：“想捐肾？以丈夫的身份捐。这婚离不了。”周明宇捂脸泣不成声，行李箱被推倒，衣物散落。"
        ],
        "ending": "林夏拒绝了丈夫自以为是的情感绑架，用划掉离婚协议的行动夺回了关系的主导权，两人在泪水中达成了真正的共同面对。",
        "target_duration_sec": 180
      }
    ],
