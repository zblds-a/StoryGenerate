  "outline": {
    "title": "星空归位",
    "premise": "校图书馆每晚有一本《星空诗集》自动归位，失眠的女孩林晓与好友陈宇蹲守调查，最终发现温暖的真相。",
    "theme": "真正的陪伴不是讲道理，而是默默守护你的微小信念。",
    "beginning": "闭馆广播响起，书本自动归位的闷响打破图书馆的宁静，林晓与陈宇决定抓出放书的人。",
    "development": "两人排查线索，林晓怀疑是暗恋者所为，陈宇用理性反驳引发争执，林晓决定独自设下陷阱暗中观察。",
    "climax": "林晓在暗处亲耳听到陈宇放书的声音，现身质问，陈宇坦白自己每天提前放书是为了治愈林晓的失眠。",
    "ending": "林晓选择接受这份守护，亲手将书推回书架呼应开场，两人并肩离开，在闭馆音乐中完成情感收束。",
    "episode_outlines": [
      {
        "index": 1,
        "title": "星空归位",
        "core_goal": "揭开书本自动归位的真相，完成人物内心的治愈与和解。",
        "major_beats": [
          "【0-3s】闭馆预备铃突兀响起，紧接着书架深处传来书本被用力推入木架的“咔哒”闷响。",
          "【3-10s】林晓压低声音对陈宇说“它又自己回去了”，两人从书架后探头，决定堵住过道抓出这个“田螺姑娘”。",
          "【10-30s】两人冲出过道，却只撞见正在拖地的保洁阿姨；林晓失落叹气时，陈宇突然抽出那本《星空诗集》，伴随纸张摩擦声，从书页里抽出一张新便签。",
          "【30-120s】林晓看着便签怀疑是暗恋者，陈宇用逻辑反驳，林晓烦躁指责他“只会泼冷水”。林晓低头翻书包时，听到陈宇口袋里硬卡纸的沙沙声，且看到他手指上的蓝墨水。林晓借口去洗手间，实则绕回C区暗处蹲守。",
          "【120-170s】林晓在暗处听到陈宇特有的脚步声，接着是书本推入书架的“咔哒”声和夹纸轻响。林晓走出阴影质问，陈宇坦白自己每天利用盲区提前放书，是因为林晓失眠，只有看到书归位才能安心。",
          "【170-180s】林晓面临选择：是继续追问“为什么不直接告诉我”，还是接受这份笨拙的守护。她选择后者，拿过笔在便签写下“今晚能睡个好觉”，亲手将书推回书架，发出一声清脆的“咔哒”声完美呼应开场。两人并肩离开，闭馆音乐轻柔响起。"
        ],
        "ending": "Closed",
        "target_duration_sec": 180
      }
    ],
