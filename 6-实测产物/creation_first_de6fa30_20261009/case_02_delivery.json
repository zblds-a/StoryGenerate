  "outline": {
    "title": "归位的星空",
    "premise": "校图书馆每晚有一本书自动归位，两位朋友在深夜潜伏追踪，最终发现这是一个休学学长为鼓励熬夜同学而留下的温暖机关。",
    "theme": "青春期的隐性关怀、友谊与温暖的陪伴，打破悬疑外壳下的治愈内核。",
    "beginning": "校图书馆闭馆后，一本《追星星的人》连续三天自动飞回书架。角色1和角色2决定深夜潜伏，揭开这个轻悬疑事件背后的真相。",
    "development": "两人通过手电筒和近距离检查，打破了灵异猜想，发现书脊上的透明鱼线。顺着鱼线，他们追踪到顶楼废弃钟表室，发现机关与闭馆打铃机械钟相连。",
    "climax": "在钟表室，角色1在面临破坏机关还是耐心拆解的选择时，选择了后者，保全了机关并找到休学学长的手记，揭晓自动归位是学长为了逼迫角色1按时休息而设计的温暖机关。",
    "ending": "角色1选择顺应学长的期待，主动将书放回触发槽。在开场的归位音效与星空投影、未播完的温柔录音中戛然而止，完成情感落地与首尾呼应。",
    "episode_outlines": [
      {
        "index": 1,
        "title": "追星星的机关",
        "core_goal": "查明图书馆书本自动归位的真相，通过关键选择完成从悬疑到温暖的情感落地，并呼应开场。",
        "major_beats": [
          "【0-3秒 黄金钩子】闭馆广播余音刚落，黑暗中突发‘嗖——啪’的清脆声响，一本书精准飞入高层书架。",
          "【3-10秒 矛盾三要素】角色1和角色2躲在借阅台后，角色1压低声音确认：‘《追星星的人》又自动归位了，今晚必须查出是谁在装神弄鬼。’",
          "【10-30秒 第一次反转】角色2猛然打开强光手电照向书架，以为能照出鬼影却空无一人（压抑）；角色1冲上前一把抽出书，发现书脊粘着极细的透明鱼线，伴随‘铮’的琴弦音效断点（爆发）。",
          "【30-120秒 中段推进】两人顺着鱼线摸索，台词短促交锋。潜入顶楼废弃钟表室，发现卷线器与闭馆打铃的机械钟齿轮相连。角色2急于求成，拿出剪刀想直接剪断绷紧的鱼线查看底部的铁盒。",
          "【120-170秒 升级/二次反转】角色1面临选择：剪断线会彻底破坏机关，不剪则难以取出铁盒。角色1选择制止角色2，小心翼翼地手动解除齿轮卡扣，保全了机关并取出铁盒。盒内是休学学长的手记，揭晓真相：学长知道角色1备战天文竞赛压力过大，特意制作机关每天强制收走书，逼迫其按时休息。",
          "【170-180秒 强钩子】手记最后一页写着：‘如果你解开了机关，请把书放回触发槽，早点睡。’角色1做出明确选择，主动将书放入槽中。伴随开场同样的‘嗖——啪’声，书本归位，天花板瞬间亮起璀璨星空，学长预录的温柔语音响起：‘别熬夜了，星星在梦里……’声音未落，音频戛然而止。"
        ],
        "ending": "悬念彻底解开，角色1通过主动归位书本的选择接受关怀。在星空投影与未播完的录音中戛然而止，首尾音效呼应，情绪达到最高点后留白。",
        "target_duration_sec": 180
      }
    ],
    "performance_plan": {
      "voice_direction": "角色1声音带有疲惫但充满探究欲，面临选择时语气需有从犹豫到坚定的转变；角色2声音清脆、行动力强、略带急躁。两人互动需体现默契与压低声音的紧张感。",
      "sound_design": "重点设计书本滑过轨道的‘嗖啪’声（首尾呼应）、鱼线绷紧的‘铮’声、机械齿轮转动与卡扣解除的清脆金属声，以及结尾星空投影亮起的空灵音效。"
    },
    "continuity_constraints": [
      "书本归位必须依赖物理机关（鱼线与卷线器），禁止出现超自然或灵异解释。",
      "角色1和角色2是仅有的发声角色，学长的声音只能作为预录音频在结尾出现，且不能有实时互动。",
      "开场的‘嗖——啪’归位音效必须在结尾角色1主动触发时原样重现，形成听觉闭环。"
    ],
    "change_summary": [
      "人物认知与选择变化：角色1从怀疑灵异、试图破坏机关，转变为理解学长苦心，并主动选择顺应机关去休息。",
      "环境状态变化：从黑暗紧张的图书馆借阅区，转移到充满温暖回忆与星空投影的顶楼钟表室。"
    ]
  },
