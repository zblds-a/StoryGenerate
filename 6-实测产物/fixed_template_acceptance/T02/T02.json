  "outline": {
    "title": "过界的椅子",
    "premise": "分居半年的夫妻在女儿的小学毕业典礼上被迫挤在同一张椅子上，在互相试探与刺痛中，发现彼此都因分离而伤痕累累，最终在女儿的广播声中达成了无声的和解。",
    "theme": "破镜重圆、互相救赎、克制的温柔",
    "beginning": "毕业典礼开场前，苏南匆忙落座挤到林宇，两人因座位界限发生低烈度口角，苏南的包意外掉落，暴露出她分居期间服用抗焦虑药物的秘密。",
    "development": "林宇发现药物后，两人开始用带刺的语言互相试探。苏南指出林宇衬衫扣错的细节，林宇意识到苏南的失眠与痛苦，两人陷入互相心疼却又互相推开的拉扯中。",
    "climax": "典礼暗灯，林宇在黑暗中拧开水递给苏南，并交出净身出户的抚养权协议，坦白自己这半年的悔恨。苏南拒绝接受，认为两人已经回不到过去。",
    "ending": "在女儿通过礼堂广播发表毕业感言的声音中，苏南没有拿走协议，而是在黑暗中主动握住了林宇递水的手，两人在掌声中达成了无需言语的双向治愈。",
    "episode_outlines": [
      {
        "index": 1,
        "title": "过界的椅子",
        "core_goal": "在女儿毕业典礼的短暂时间里，完成夫妻两人从互相防备到坦诚内心、最终和解的情感转变。",
        "major_beats": [
          "[0-3s] 突发听觉事件：椅子腿刺耳刮擦地面。林宇压低声音警告：‘你坐过界了。’",
          "[3-10s] 苏南回应典礼快开始了别吵，要求林宇往里挪；林宇反驳是苏南挤了他，交代两人分居后在女儿毕业典礼上被迫同座的尴尬处境。",
          "[10-30s] 两人暗中推挤，苏南的帆布包滑落，药瓶和纸张散落一地。环境音瞬间安静（音乐断点），林宇捡起药瓶，看清标签上的‘抗焦虑’字样，动作僵住。",
          "[30-120s] 林宇把药递回，声音发紧询问她何时开始吃药；苏南一把夺过，用‘跟你没关系’掩饰慌乱。林宇自嘲以为她离开后很轻松，苏南反唇相讥指出他衬衫扣子扣错了一颗，点破他这半年同样过得一团糟。",
          "[120-153s] 礼堂暗灯，典礼开始。林宇在黑暗中拧开矿泉水递给苏南，并递上签好字的净身出户协议，坦白自己每天都在悔恨当初的脾气。苏南声音颤抖地拒绝，说‘我们回不去了’。",
          "[153-180s] 核心情感信息已交代。台上女儿淼淼的广播声响起：‘感谢爸爸妈妈教会我勇敢’。苏南没有接协议，而是在黑暗中轻轻覆上林宇递水的手。林宇反握。只有两人交错的呼吸声与全场掌声。"
        ],
        "ending": "closed_with_hope",
        "target_duration_sec": 180
      }
    ],
