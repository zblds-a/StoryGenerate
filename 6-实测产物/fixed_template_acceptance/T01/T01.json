  "outline": {
    "title": "止损",
    "premise": "妻子发现丈夫偷偷将五十万家庭存款借给赌博的弟弟，面对丈夫的道德绑架与谎言，她拒绝内耗，用确凿证据和报警手段完成绝地反击，彻底切割有毒婚姻。",
    "theme": "亲密关系中的底线捍卫与自我觉醒，拒绝以亲情为名的剥削。",
    "beginning": "林晓以耳光和碎杯声打破家庭表面的平静，直接甩出银行流水，点破丈夫陈建转移五十万存款给赌徒弟弟的事实，下达最后通牒。",
    "development": "陈建试图用‘亲情’和‘弟弟的安危’进行道德绑架，并谎称钱能追回。林晓不为所动，播放弟弟毫无悔意的语音戳破谎言，并步步紧逼引出陈建偷卖妻子婚前车辆的底牌。",
    "climax": "陈建崩溃承认偷车抵押，林晓亮出报警回执，宣告已按盗窃罪立案，将家庭内部的经济纠纷直接升级为不可逆的法律制裁，彻底击溃陈建的心理防线。",
    "ending": "面对陈建‘为了孩子’的乞求，林晓坚决不撤案，拉着行李箱离开。在关门的物理隔绝后，她以平静的语气安抚孩子，完成了从隐忍妻子到独立母亲的蜕变。",
    "episode_outlines": [
      {
        "index": 1,
        "title": "五十万的代价",
        "core_goal": "林晓通过收集证据和报警，彻底切断丈夫对原生家庭的无底线输血，拿回婚姻与财产的自主权。",
        "major_beats": [
          "【0-3s】【音效：清脆耳光声与玻璃杯砸碎声】林晓扇陈建耳光并砸碎水杯，打断其辩解，以突发听觉事件确立不再忍让的强势姿态。",
          "【3-10s】林晓将银行流水单拍在桌上，点明陈建私自转走五十万定期给弟弟陈宇，下达‘一个月内钱回来，否则我带孩子搬走’的通牒。",
          "【10-30s】陈建大声辩解‘亲弟欠高利贷会被砍手’，林晓不提高音量，直接甩出离婚协议和搬家公司收据，用事实反击道德绑架，迫使陈建闭嘴。",
          "【30-120s】陈建谎称弟弟下周还钱，林晓播放提前保存的陈宇微信语音（‘哥，五十万输光了，嫂子闹你就打她’），戳破谎言；陈建恼羞成怒试图抢手机，林晓后退躲开并冷笑提示他‘车也保不住了’。",
          "【120-153s】陈建崩溃承认偷开林晓婚前代步车去抵押填窟窿，林晓展示手机报警回执，平静宣告已按盗窃罪立案且警察五分钟后到，将家庭冲突升级为不可逆的法律后果。",
          "【153-180s】陈建瘫软哭求‘为了孩子别报警’，林晓拉起行李箱（滑轮声），平静宣告‘五十万买断七年感情’，开门离去并重重关门；门外林晓长舒一口气，轻声对孩子说‘妈妈带你回家’，完成情感收束。"
        ],
        "ending": "林晓拒绝丈夫的道德绑架，以盗窃罪将其送上法庭，拉着行李箱带孩子离开，完成物理与心理的双重切割，留下关门声与门外的温柔低语作为余韵。",
        "target_duration_sec": 180
      }
    ],
