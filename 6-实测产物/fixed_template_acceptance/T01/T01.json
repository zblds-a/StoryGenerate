  "outline": {
    "title": "止损",
    "premise": "丈夫偷偷将家中三十万存款借给赌博的弟弟，妻子发现后下达最后通牒，逼迫丈夫在原生家庭的无底洞和自己的小家之间做出彻底切割。",
    "theme": "亲密关系中的界限重塑与自我觉醒",
    "beginning": "妻子用银行流水和弟弟的语音留言戳破丈夫的谎言，下达一个月追回存款否则带娃离开的最后通牒。",
    "development": "丈夫试图用亲情道德绑架，妻子不为所动，用实际行动（打包行李）和现实代价（学区房首付）逼迫丈夫直面问题，丈夫被迫当场打电话要钱。",
    "climax": "弟弟在电话中不仅拒绝还钱，还威胁要去丈夫单位闹事，彻底击碎了丈夫对亲情的最后幻想。",
    "ending": "丈夫觉醒，报警并拉黑弟弟，交出车钥匙和房产证作为补偿与承诺。妻子收回财政大权，家庭权力关系重新定义。",
    "episode_outlines": [
      {
        "index": 1,
        "title": "止损",
        "core_goal": "妻子用事实和底线逼迫丈夫在“无底洞弟弟”和“自己的小家”之间做出最终切割，夺回家庭主导权。",
        "major_beats": [
          "[0-3s] 连续三声刺耳的银行扣款短信提示音响起，林晓将一沓银行流水单重重拍在餐桌上，打破家中的安静。",
          "[3-10s] 林晓平静陈述事实：‘三十万，转给你弟还赌债。一个月追不回来，我带豆豆走。’明确核心冲突与最后通牒。",
          "[10-30s] 陈建明辩解‘只是临时借’，林晓按下手机播放陈建辉的语音留言（‘哥，三十万拿去翻本，赢了给你换车’），用铁证戳破谎言，陈建明语塞。",
          "[30-120s] 陈建明用‘血浓于水’道德绑架，林晓不争吵，直接拉开行李箱拉链开始打包衣物。陈建明慌乱阻拦，林晓用‘豆豆的学区房首付’反击，逼迫其面对现实代价。",
          "[120-150s] 陈建明被迫免提拨打陈建辉电话要钱，陈建辉在电话中耍无赖并威胁‘不给钱就去你单位闹’。陈建明听到威胁后呼吸加重，彻底认清弟弟的真面目。",
          "[150-180s] 陈建明挂断电话并拉黑弟弟，将车钥匙和房产证推到林晓面前，承诺卖车补钱并过户房产。林晓收起钥匙，以‘看你表现’回应，确立新的家庭权力平衡，故事平稳收束。"
        ],
        "ending": "Closed",
        "target_duration_sec": 180
      }
    ],
