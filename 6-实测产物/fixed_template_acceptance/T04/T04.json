  "outline": {
    "title": "暗流1992：第七十三号坐标",
    "premise": "1992年国企改制浪潮中，保密干事林秋雁为查明搭档失踪真相，循着旧书里的加密坐标，撞破了时代洪流下国有资产流失的巨大黑幕。",
    "theme": "在时代巨变与利益诱惑前，小人物对真相与底线的坚守。",
    "beginning": "林秋雁拒绝在搭档“携密潜逃”的结案报告上签字，与急于推进改制的老领导老赵发生激烈冲突。",
    "development": "林秋雁从搭档遗留的旧书中发现加密坐标，不顾老赵关于“破坏改制大局”的警告，独自前往废弃的73号防空洞探查。",
    "climax": "在防空洞内，林秋雁发现被倒卖的“报废”核心设备，并找到搭档留下的警示暗号，证实了搭档因揭露黑幕而遇险。",
    "ending": "老赵与私人老板出现在防空洞外并锁死铁门，林秋雁陷入绝境，长线悬念展开。",
    "episode_outlines": [
      {
        "index": 1,
        "title": "第一集：旧书里的坐标",
        "core_goal": "查明搭档失踪的初步线索，并抵达坐标地点发现核心秘密。",
        "major_beats": [
          "[0-5s] 收音机播报“股份制改造试点”新闻中，林秋雁用力划破结案报告纸张，老赵推门而入将“停薪留职表”拍在桌上，建立改制与失踪案的双重压迫。",
          "[5-17s] 老赵催促林秋雁签字定性陈建国“携密潜逃”以换取改制补贴，林秋雁拒绝并质问，交代两人立场冲突与当前麻烦。",
          "[17-50s] 老赵称陈建国已去深圳倒卖批文，林秋雁拿出陈建国留下的《地质勘探手册》，伴随撕开书页胶水的裂音，掉出带有陈建国特有标高符号的坐标纸条，完成第一次反转。",
          "[50-200s] 林秋雁认出坐标指向73号废弃防空洞，老赵警告那里已被私人老板承包，去探查会破坏厂里改制大局；林秋雁反驳“连真相都不要算什么大局”，夺门而出。伴随街头“下海”叫卖与BP机滴滴声，她骑车前往坐标地。",
          "[200-283s] 林秋雁进入防空洞，在滴水与回音中摸索，发现堆满厂里申报“报废”的进口数控机床核心部件；她找到陈建国用粉笔画的地质警示暗号，推断出他因发现倒卖证据而遇险，真相升级。",
          "[283-300s] 铁门突然作响，老赵与私人老板的声音从门外传来，老赵说“我知道她看了书会来，把门锁死”，林秋雁意识到老赵已妥协并被困，留下强悬念。"
        ],
        "ending": "老赵锁死防空洞铁门，林秋雁被困于倒卖现场，面临生存与揭露真相的双重危机。",
        "target_duration_sec": 300
      }
    ],
