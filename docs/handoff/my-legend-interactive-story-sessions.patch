+                "strength": "medium"
+              }
+            ],
+            "speech_rate": 1.0,
+            "pitch": null,
+            "volume": null,
+            "pauses": [],
+            "delivery_note": "语气平常，但目光已经落在小墨紧皱的眉头上。；两句之间留短停顿，问句尾音不上扬太多",
+            "audio_cue_ref": null
+          },
+          {
+            "line_id": "aeb5f5b10f7f4b5e9c4d1d964fd1624f-l7",
+            "kind": "dialogue",
+            "speaker_role_id": "mo",
+            "narrator_id": null,
+            "performer_id": "performer-mo",
+            "text": "阿青……这个，好像坏了。",
+            "emotion": "worried",
+            "tone_instruction": "先轻声叫名字，后半句气声化，像把坏消息慢慢递过去",
+            "emphasis": [
+              {
+                "span_text": "坏了",
