+                "strength": "medium"
+              }
+            ],
+            "speech_rate": 0.92,
+            "pitch": null,
+            "volume": null,
+            "pauses": [],
+            "delivery_note": "平稳地铺陈环境，营造宁静中略带不安的氛围。；在“屋内”后做短停顿，台灯光圈一句放慢，整体音量偏轻",
+            "audio_cue_ref": null
+          },
+          {
+            "line_id": "aeb5f5b10f7f4b5e9c4d1d964fd1624f-l2",
+            "kind": "action",
+            "speaker_role_id": null,
+            "narrator_id": null,
+            "performer_id": "narrator",
+            "text": "小墨坐在桌前，反复按下录音笔的播放键。",
+            "emotion": null,
+            "tone_instruction": null,
+            "emphasis": [],
+            "speech_rate": 1.0,
+            "pitch": null,
+            "volume": null,
+            "pauses": [],
+            "delivery_note": null,
+            "audio_cue_ref": null
+          },
+          {
+            "line_id": "aeb5f5b10f7f4b5e9c4d1d964fd1624f-l3",
+            "kind": "dialogue",
+            "speaker_role_id": "mo",
+            "narrator_id": null,
+            "performer_id": "performer-mo",
+            "text": "怎么又是这样……",
+            "emotion": "worried",
+            "tone_instruction": "压着喉咙低声自语，尾音往下掉，带一点发闷的无力感",
