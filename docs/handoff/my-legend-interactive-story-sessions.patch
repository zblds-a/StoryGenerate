+            "emotion": null,
+            "tone_instruction": null,
+            "emphasis": [],
+            "speech_rate": 1.0,
+            "pitch": null,
+            "volume": null,
+            "pauses": [],
+            "delivery_note": null,
+            "audio_cue_ref": null
+          },
+          {
+            "line_id": "aeb5f5b10f7f4b5e9c4d1d964fd1624f-l5",
+            "kind": "action",
+            "speaker_role_id": null,
+            "narrator_id": null,
+            "performer_id": "narrator",
+            "text": "门被推开，阿青走进来，一边收起还在滴水的伞。",
+            "emotion": null,
+            "tone_instruction": null,
+            "emphasis": [],
+            "speech_rate": 1.0,
+            "pitch": null,
+            "volume": null,
+            "pauses": [],
+            "delivery_note": null,
+            "audio_cue_ref": null
+          },
+          {
+            "line_id": "aeb5f5b10f7f4b5e9c4d1d964fd1624f-l6",
+            "kind": "dialogue",
+            "speaker_role_id": "qing",
+            "narrator_id": null,
+            "performer_id": "performer-qing",
+            "text": "雨下大了。你怎么还没睡？",
+            "emotion": "neutral",
+            "tone_instruction": "前半句平常陈述，后半句放轻，问句不逼人",
+            "emphasis": [
+              {
+                "span_text": "雨下大了",
+                "occurrence": 1,
+                "start_char": 0,
+                "end_char": 4,
+                "strength": "medium"
+              },
+              {
+                "span_text": "还没睡",
+                "occurrence": 1,
+                "start_char": 8,
