+                "start_char": 9,
+                "end_char": 11,
+                "strength": "strong"
+              }
+            ],
+            "speech_rate": 0.9,
+            "pitch": null,
+            "volume": null,
+            "pauses": [],
+            "delivery_note": "声音很轻，把录音笔递过去，带着歉意和不安。；“阿青”后停顿一拍，“好像”不要重读，句尾气息收弱",
+            "audio_cue_ref": null
+          },
+          {
