diff --git a/source/my-legend-production/tests/test_interactive_bridge.py b/source/my-legend-production/tests/test_interactive_bridge.py
new file mode 100644
index 0000000000000000000000000000000000000000..ad7e00ee152012d04c521856e412b979dbe92e54
--- /dev/null
+++ b/source/my-legend-production/tests/test_interactive_bridge.py
@@ -0,0 +1,47 @@
+"""No providers or production DB: exercise the real confirmed-delivery handoff."""
+from contextlib import contextmanager
+from pathlib import Path
+import json
+import pytest
+from my_legend_production.production.interactive import media_submit
+from my_legend_production.production.artifacts import ArtifactStore
+from my_legend_production.production.contracts import ProductionRequest
+
+
+@pytest.fixture
+def delivery():
+    return json.loads((Path(__file__).resolve().parents[1] / 'examples/source/story_delivery.json').read_text(encoding='utf-8'))
+
+
+def test_no_media_before_script_confirmation(delivery, tmp_path):
+    with pytest.raises(ValueError, match='SCRIPT_CONFIRMATION_REQUIRED'):
+        media_submit(None, ArtifactStore(tmp_path))({'confirmed_version': None, 'delivery': delivery}, 'key')
+    assert list(tmp_path.iterdir()) == []
+
+
+def test_confirmed_version_registers_owned_sources_and_creates_existing_flow(delivery, tmp_path, monkeypatch):
+    statements, flows = [], []
+    class Repo:
+        @contextmanager
+        def transaction(self):yield self
+        def execute(self, query, parameters):statements.append((query, parameters))
+    def insert(self, owner, key, original, request, casting, work_id):
+        req = ProductionRequest.model_validate(request['sound'])
+        assert req.source.source_version_id == delivery['story_version_id']
+        assert req.source.delivery.source_version_id == req.source.manifest.source_version_id
+        assert req.review_policy == 'listen_first'
+        assert request['stage_mode'] == 'basic_stage/1'
+        flows.append((owner, key, original, request, casting, work_id))
+        return 'confirmed-flow'
+    monkeypatch.setattr('my_legend_production.production.flows.FlowService.insert', insert)
+    state = dict(id='session', owner='alice', story_id=delivery['story_id'],
+        confirmed_version=delivery['story_version_id'], delivery=delivery, creation={'output':'audio'})
+    result = media_submit(Repo(), ArtifactStore(tmp_path))(state, 'fixed-confirmed-key')
+    assert result['flow_id'] == 'confirmed-flow'
+    assert len(statements) == 2 and len(flows) == 1
+    assert all(params[0] == 'alice' and params[2] == delivery['story_version_id'] for _, params in statements)
+
+
+def test_mismatched_confirmed_version_is_rejected(delivery, tmp_path):
+    with pytest.raises(ValueError, match='SCRIPT_CONFIRMATION_REQUIRED'):
+        media_submit(None, ArtifactStore(tmp_path))({'confirmed_version':'different', 'delivery':delivery}, 'key')
diff --git a/source/my-legend-production/tests/test_interactive_postgres.py b/source/my-legend-production/tests/test_interactive_postgres.py
new file mode 100644
index 0000000000000000000000000000000000000000..c0ba7beca612e2c62a826e3a24562236b934a42d
--- /dev/null
+++ b/source/my-legend-production/tests/test_interactive_postgres.py
@@ -0,0 +1,50 @@
+"""Real isolated PostgreSQL handoff, without providers or synthetic successful audio."""
+from copy import deepcopy
+import pytest
+from test_production_queue import env
+from test_interactive_bridge import delivery
+from drama_engine.interactive.models import Creation, Command, fingerprint
+from drama_engine.interactive.service import Worker
+from my_legend_production.production.interactive import session_service, media_submit
+from my_legend_production.production.flows import FlowService
+from my_legend_production.production.story import StoryStage
+from my_legend_production.production.worker import ProductionWorker
+from my_legend_production.production.contracts import ProductionRequest
+from my_legend_production.production.repository import ProductionError
+
+
+def test_confirmed_session_handoff_owner_and_no_duplicate_production(env, delivery):
+    repo, artifacts = env
+    service = session_service(repo)
+    service.store.migrate()
+    chars = [dict(character_id='a',role_id='a',performer_id='performer-a',canon={'name':'阿青'},profile={})]
+    session = service.create('alice', Creation(idempotency_key='postgres-session',character_ids=['a'],method='idea',idea='合作'),chars)
+    sid = session['id']
+    def ready(s):
+        s.update(stage='script_ready',delivery=delivery,script_fingerprint=fingerprint(delivery))
+    service.store.mutate(sid,'alice',ready)
+    assert repo.list_jobs('alice')['items'] == []
+    raw = service.store.get(sid,'alice')
+    command = Command(command_id='postgres-confirm',expected_revision=raw['revision'],kind='confirm_script',
+        target_id=delivery['story_version_id'],fingerprint=fingerprint(delivery))
+    service.command(sid,'alice',command)
+    worker = Worker(service, lambda: None, media_submit(repo, artifacts))
+    assert worker.run_once()
+    receipt = service.command(sid,'alice',command)
+    assert receipt['session']['stage'] == 'media_ready'
+    assert not worker.run_once()
+    flows = FlowService(repo,artifacts)
+    assert len(flows.listing('alice')['items']) == 1
+    fid = service.store.get(sid,'alice')['media']['flow_id']
+    flows.advance(fid,'alice')
+    sound = flows.jobs(flows.row(fid,'alice'))['sound']
+    assert sound['request']['source']['source_version_id'] == delivery['story_version_id']
+    foreign = deepcopy(sound['request']);foreign['idempotency_key']='foreign-session-source'
+    with pytest.raises(ProductionError,match='SOURCE_ARTIFACT_NOT_OWNED'):
+        repo.create('bob',ProductionRequest.model_validate(foreign))
+    # Consume the actual immutable handoff; no remote story service may be called.
+    assert ProductionWorker(repo,artifacts,{'story':StoryStage(None)},only_configured_stages=True).tick()
+    result = repo.get(sound['id'],'alice')
+    assert next(s for s in result['stages'] if s['name']=='story')['status'] == 'succeeded'
+    assert result['actual_calls'] == 0
+    service.store.engine.dispose()
