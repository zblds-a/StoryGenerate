+                "start_char": 2,
+                "end_char": 6,
+                "strength": "strong"
+              }
+            ],
+            "speech_rate": 0.88,
+            "pitch": null,
+            "volume": null,
+            "pauses": [],
+            "delivery_note": "低声自语，带着压抑的焦虑和一丝无助。；“怎么”轻轻带出，省略号处收住气息，不拖长音",
+            "audio_cue_ref": null
+          },
+          {
